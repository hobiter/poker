{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnalyticsEvent",
  "type": "object",
  "required": ["eventId", "timestamp", "eventType"],
  "properties": {
    "eventId": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "roomId": { "type": "string" },
    "sessionId": { "type": "string" },
    "handId": { "type": "string" },
    "playerSessionId": { "type": "string" },
    "eventType": { "type": "string", "enum": ["blind_posted","action","showdown","pot_awarded","disconnect","reconnect"] },
    "actionType": { "type": "string", "enum": ["fold","check","call","bet","raise","all-in","post_sb","post_bb"] },
    "amount": { "type": ["integer","null"], "minimum": 0 },
    "street": { "type": "string", "enum": ["preflop","flop","turn","river","showdown","null" ] },
    "stackBefore": { "type": ["integer","null"], "minimum": 0 },
    "stackAfter": { "type": ["integer","null"], "minimum": 0 },
    "flags": {
      "type": "object",
      "properties": {
        "isVPIP": { "type": "boolean" },
        "isPFR": { "type": "boolean" },
        "wentToShowdown": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "meta": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false,
  "examples": [
    {
      "eventId": "evt_0001",
      "timestamp": "2026-05-11T12:00:00Z",
      "roomId": "room_abc",
      "sessionId": "sess_123",
      "handId": "hand_045",
      "playerSessionId": "ps_789",
      "eventType": "action",
      "actionType": "raise",
      "amount": 150,
      "street": "preflop",
      "stackBefore": 2000,
      "stackAfter": 1850,
      "flags": { "isVPIP": true, "isPFR": true }
    }
  ]
}
